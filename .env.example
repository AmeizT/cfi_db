# Public application URLs
NEXT_PUBLIC_CLIENT_DEV_URL=
NEXT_PUBLIC_CLIENT_PROD_URL=
NEXT_PUBLIC_SERVER_DEV_URL=
NEXT_PUBLIC_SERVER_PROD_URL=

# Preferred API URL. When set, this replaces the matching legacy SERVER_* value.
NEXT_PUBLIC_API_URL=

# Defaults to false in development (direct Django requests) and true in
# production (same-origin gateway). Set it explicitly in each deployment.
NEXT_PUBLIC_API_PROXY_ENABLED=
NEXT_PUBLIC_API_PROXY_PATH=/api/backend

# Authentication and workspace configuration
NEXT_PUBLIC_WORKSPACE_DOMAIN=
NEXT_PUBLIC_DEVMODE=

# Server-only Django origin for current-user, auth and gateway requests.
# Takes precedence over NEXT_PUBLIC_API_URL on the server. Set separately in
# Vercel Preview and Production; never use localhost in deployed environments.
# NEXT_PUBLIC_* values are bundled at build time: redeploy after changing them.
DJANGO_API_URL=
